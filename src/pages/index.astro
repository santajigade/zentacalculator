---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config.ts';
import { CATEGORIES } from '../data/categories.ts';
import { allCalcs, urlOf } from '../lib/calcs.ts';

const calcs = await allCalcs();
const count = (slug: string) => calcs.filter((c) => c.data.category === slug).length;
const featured = calcs.filter((c) => c.data.featured);
const schema = [{
  '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: SITE.url, logo: `${SITE.url}/apple-touch-icon.png`,
  founder: { '@type': 'Person', name: 'Santaji Gadepatil', url: `${SITE.url}/author/santaji-gadepatil/`, sameAs: ['https://www.linkedin.com/in/santaji-gadepatil6680/'] },
}, {
  '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url,
  potentialAction: { '@type': 'SearchAction', target: `${SITE.url}/?q={query}`, 'query-input': 'required name=query' },
}];
---
<Base title="Free Online Calculators for Engineering, Science, Math & Finance" description={`${calcs.length}+ free online calculators: electrical, electronics, engineering, physics, chemistry, math, statistics, unit conversion, finance and health. Solve for any value with steps and charts.`} schema={schema}>
  <section class="hero wrap">
    <h1>Calculators that solve <em>for any value</em></h1>
    <p>Fill in whatever you know. We calculate the rest, show every step, and plot how the result changes.</p>
    <div class="stats">
      <div><b>{calcs.length}</b><span>calculators</span></div>
      <div><b>{CATEGORIES.length}</b><span>categories</span></div>
      <div><b>0</b><span>sign-ups needed</span></div>
    </div>
  </section>

  <div class="wrap">
    {featured.length > 0 && <>
      <h2 class="section-title">Popular right now</h2>
      <ul class="calc-list">
        {featured.map((c) => <li><a href={urlOf(c)}><b>{c.data.title}</b><span>{c.data.description}</span></a></li>)}
      </ul>
    </>}

    <h2 class="section-title">Browse by category</h2>
    <div class="cat-grid">
      {CATEGORIES.map((c) => (
        <a class="cat-card" href={`/${c.slug}/`} style={`--c:${c.color}`}>
          <span class="cat-card__icon" aria-hidden="true">{c.icon}</span>
          <h3>{c.name}</h3>
          <p>{c.blurb}</p>
          <span class="cat-card__n">{count(c.slug)} calculator{count(c.slug) === 1 ? "" : "s"} →</span>
        </a>
      ))}
    </div>
  </div>
</Base>
