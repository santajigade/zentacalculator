---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.config.ts';
import { CATEGORIES, catBySlug } from '../../data/categories.ts';
import { CAT_SEO } from '../../data/catseo.ts';
import { CAT_EXTRA } from '../../data/catseo-extra.ts';
import { allCalcs, urlOf } from '../../lib/calcs.ts';
import { POPULAR } from '../../data/popular.ts';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}
const cat = catBySlug(Astro.params.category!)!;
const baseSeo = CAT_SEO[cat.slug];
const extra = CAT_EXTRA[cat.slug];
const seo = baseSeo && extra ? { ...baseSeo,
  groups: baseSeo.groups?.length ? baseSeo.groups : extra.groups,
  about: [...(baseSeo.about ?? []), ...(extra.about ?? [])],
  faq: [...(baseSeo.faq ?? []), ...(extra.faq ?? [])] } : baseSeo;
const calcs = (await allCalcs()).filter((c) => c.data.category === cat.slug);
const slugOf = (c: (typeof calcs)[number]) => c.id.split('/').pop()!;
const pop = POPULAR.map((id) => calcs.find((c) => `${c.data.category}/${slugOf(c)}` === id)).filter((c): c is NonNullable<typeof c> => !!c);
const top = [...pop, ...calcs.filter((c) => c.data.featured && !pop.includes(c))].slice(0, 8);

// grouped sections; anything not listed goes to "More"
const groups = (seo?.groups ?? []).map((g) => ({ name: g.name, items: g.ids.map((id) => calcs.find((c) => slugOf(c) === id)).filter((c): c is NonNullable<typeof c> => !!c) })).filter((g) => g.items.length);
const grouped = new Set(groups.flatMap((g) => g.items));
const rest = calcs.filter((c) => !grouped.has(c));
if (groups.length && rest.length) groups.push({ name: `More ${cat.name.toLowerCase()} calculators`, items: rest });
const shortTitle = (t: string) => t.replace(/\s*\([^)]*\)/g, '').replace(/\s+[–—]\s+.*$/, '');
const sections = groups.length ? groups : calcs.length ? [{ name: `All ${cat.name.toLowerCase()} calculators`, items: calcs }] : [];
const slugify = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const md = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;')
  .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
  .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_m, l, u) => /^https?:/.test(u) ? `<a href="${u}" target="_blank" rel="noopener">${l}</a>` : `<a href="${u}">${l}</a>`);

const schema: object[] = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: cat.name, item: `${SITE.url}/${cat.slug}/` } ] },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: seo?.h1 ?? `${cat.name} calculators`, url: `${SITE.url}/${cat.slug}/`, description: seo?.description,
    mainEntity: { '@type': 'ItemList', numberOfItems: calcs.length, itemListElement: calcs.map((c, i) => (
      { '@type': 'ListItem', position: i + 1, url: `${SITE.url}${urlOf(c)}`, name: c.data.title })) } },
];
if (seo?.faq?.length) schema.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: seo.faq.map((f) => (
  { '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const title = seo?.title ?? `${cat.name} Calculators`;
const description = seo?.description ?? `${calcs.length} free ${cat.name.toLowerCase()} calculators. ${cat.blurb}`;
---
<Base title={title} description={description} schema={schema} activeCat={cat.slug} noindex={calcs.length === 0} image={`/og/${cat.slug}.jpg`}>
  <div class="wrap">
    <header class="cx-hero">
      <nav class="cx-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>{cat.name}</span></nav>
      <div class="cx-hero__row">
        <div class="cx-hero__text">
          <h1>{seo?.h1 ?? `${cat.name} calculators`}</h1>
          {seo?.intro ? <p set:html={md(seo.intro)} /> : <p>{cat.blurb}</p>}
          <ul class="cx-stats"><li>{calcs.length} calculators</li>{sections.length > 1 && <li>{sections.length} topics</li>}<li>Free, no sign-up</li></ul>
        </div>
        {calcs.length > 0 && (
          <label class="cx-search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            <input type="search" placeholder={`Search ${cat.name.toLowerCase()} calculators`} aria-label={`Search ${cat.name.toLowerCase()} calculators`} data-cx-search />
          </label>
        )}
      </div>
    </header>

    {top.length > 0 && (
      <section class="cx-pop" aria-label={`Most popular ${cat.name.toLowerCase()} calculators`}>
        {top.slice(0, 4).map((c) => <a href={urlOf(c)}><span class="cx-pop__k">Popular</span><b>{shortTitle(c.data.title)}</b><span class="cx-pop__d">{c.data.description.replace(/\s+[–—]\s+/g, ', ')}</span></a>)}
      </section>
    )}

    {sections.length ? (
      <div class="cx-body">
        {sections.length > 1 && (
          <nav class="cx-nav" aria-label="Topics">
            <span class="cx-nav__h">Topics</span>
            <ul>{sections.map((g) => <li><a href={`#${slugify(g.name)}`}><span>{g.name}</span><em>{g.items.length}</em></a></li>)}</ul>
          </nav>
        )}
        <div class="cx-list">
          {sections.map((g) => (
            <section class="cx-group" id={slugify(g.name)}>
              <h2>{g.name} <span>{g.items.length}</span></h2>
              <ul>{g.items.map((c) => <li><a href={urlOf(c)} title={c.data.description}><span>{shortTitle(c.data.title)}</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a></li>)}</ul>
            </section>
          ))}
          <p class="cx-empty muted" hidden>No calculators match your search.</p>
        </div>
      </div>
    ) : <p class="muted" style="padding:40px 0">Calculators coming soon.</p>}
    <script>
      const q = document.querySelector<HTMLInputElement>('[data-cx-search]');
      const groups = [...document.querySelectorAll<HTMLElement>('.cx-group')];
      q?.addEventListener('input', () => {
        const v = q.value.trim().toLowerCase(); let any = false;
        groups.forEach((g) => { let n = 0; g.querySelectorAll<HTMLLIElement>('li').forEach((li) => { const hit = !v || li.textContent!.toLowerCase().includes(v) || (li.querySelector('a')!.title || '').toLowerCase().includes(v); li.hidden = !hit; if (hit) n++; }); g.hidden = n === 0; if (n) any = true; });
        document.querySelector<HTMLElement>('.cx-empty')!.hidden = any;
      });
      const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.cx-nav a')];
      const spy = () => { let i = 0; groups.forEach((g, k) => { if (!g.hidden && g.getBoundingClientRect().top < 170) i = k; }); navLinks.forEach((a, k) => a.classList.toggle('is-active', k === i)); };
      if (navLinks.length) { spy(); addEventListener('scroll', spy, { passive: true }); }
    </script>

    {(seo?.about?.length || seo?.faq?.length) && (
      <div class="prose cat-prose">
        {seo?.about?.map((a) => <><h2>{a.h}</h2><p set:html={md(a.p)} /></>)}
        {seo?.faq?.length && <section class="faq">
          <h2>Frequently asked questions</h2>
          {seo.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </section>}
      </div>
    )}

    <h2 class="cat-h2">Explore other categories</h2>
    <p class="cat-links">{CATEGORIES.filter((c) => c.slug !== cat.slug).map((c) => <a href={`/${c.slug}/`}>{c.name}</a>)}</p>
  </div>
</Base>
