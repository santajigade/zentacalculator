---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { SITE } from '../site.config.ts';
import { CATEGORIES } from '../data/categories.ts';
import Logo from '../components/Logo.astro';
import { allCalcs } from '../lib/calcs.ts';
const total = (await allCalcs()).length;

interface Props { title: string; description: string; schema?: object[]; activeCat?: string; noindex?: boolean; }
const { title, description, schema = [], activeCat, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/', SITE.url).href;
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:image" content={`${SITE.url}/og-image.png`} />
  <meta name="theme-color" content="#4f5bff" />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="hdr">
    <div class="hdr__top wrap">
      <Logo id="lg-h" />
      <div class="search" role="search">
        <input id="q" type="search" placeholder={`Search ${total} calculators…`} autocomplete="off" aria-label="Search calculators"
          aria-controls="q-results" aria-expanded="false" />
        <kbd class="search__kbd">/</kbd>
        <ul id="q-results" class="search__results" role="listbox" hidden></ul>
      </div>
      <button class="theme" id="theme" type="button" aria-label="Toggle dark mode">◐</button>
    </div>
    <nav class="cats wrap" aria-label="Categories">
      {CATEGORIES.map((c) => (
        <a href={`/${c.slug}/`} class:list={['cats__a', { 'is-active': activeCat === c.slug }]}>{c.name}</a>
      ))}
    </nav>
  </header>

  <main id="main"><slot /></main>

  <footer class="ftr">
    <div class="wrap ftr__grid">
      <div>
        <Logo id="lg-f" />
        <p class="muted">{SITE.tagline}.</p>
      </div>
      <div class="ftr__cats">
        {CATEGORIES.map((c) => <a href={`/${c.slug}/`}>{c.name}</a>)}
      </div>
    </div>
    <nav class="wrap ftr__links" aria-label="Site">
      <a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy Policy</a><a href="/terms-of-use/">Terms of Use</a><a href="/disclaimer/">Disclaimer</a>
    </nav>
    <p class="wrap muted ftr__copy">© {new Date().getFullYear()} {SITE.name}. Results are for information only.</p>
  </footer>

  <script>
    // Theme toggle
    const root = document.documentElement;
    document.getElementById('theme')?.addEventListener('click', () => {
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch {}
    });

    // Instant search over /search.json (title + keywords + category)
    type Item = { t: string; u: string; c: string; k: string };
    const q = document.getElementById('q') as HTMLInputElement;
    const list = document.getElementById('q-results') as HTMLUListElement;
    let items: Item[] | null = null, sel = -1, hits: Item[] = [];
    const load = async () => { if (!items) items = await (await fetch('/search.json')).json(); };
    const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]!));
    const render = () => {
      list.innerHTML = hits.map((h, i) =>
        `<li role="option" aria-selected="${i === sel}"><a href="${h.u}"><span>${esc(h.t)}</span><small>${esc(h.c)}</small></a></li>`).join('')
        || (q.value.trim() ? '<li class="search__none">No calculator found</li>' : '');
      list.hidden = !list.innerHTML; q.setAttribute('aria-expanded', String(!list.hidden));
    };
    q.addEventListener('focus', load);
    q.addEventListener('input', async () => {
      await load();
      const words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
      hits = words.length ? items!.map((it) => {
        const t = it.t.toLowerCase(), hay = `${t} ${it.k} ${it.c.toLowerCase()}`;
        if (!words.every((w) => hay.includes(w))) return null;
        const score = words.reduce((s, w) => s + (t.startsWith(w) ? 3 : t.includes(w) ? 2 : 1), 0);
        return { it, score };
      }).filter(Boolean).sort((a, b) => b!.score - a!.score).slice(0, 8).map((x) => x!.it) : [];
      sel = -1; render();
    });
    q.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { sel = Math.min(sel + 1, hits.length - 1); render(); e.preventDefault(); }
      else if (e.key === 'ArrowUp') { sel = Math.max(sel - 1, 0); render(); e.preventDefault(); }
      else if (e.key === 'Enter' && hits[Math.max(sel, 0)]) location.href = hits[Math.max(sel, 0)].u;
      else if (e.key === 'Escape') { list.hidden = true; q.blur(); }
    });
    document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.search')) list.hidden = true; });
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && !(e.target as Element).closest('input,textarea,select')) { e.preventDefault(); q.focus(); }
    });
  </script>
</body>
</html>
