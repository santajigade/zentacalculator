---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Calculator from '../../components/Calculator.tsx';
import { SITE } from '../../site.config.ts';
import { catBySlug } from '../../data/categories.ts';
import { authorById, authorUrl } from '../../data/authors.ts';
import { POPULAR } from '../../data/popular.ts';
import { allCalcs, findCalc, slugOf, urlOf, embedSnippet, similarTo, type Calc } from '../../lib/calcs.ts';

export async function getStaticPaths() {
  const all = await allCalcs();
  return all.map((c) => ({ params: { category: c.data.category, slug: slugOf(c) }, props: { calc: c } }));
}
const { calc } = Astro.props as { calc: Calc };
const d = calc.data;
const cat = catBySlug(d.category);
if (!cat) throw new Error(`${calc.id}: unknown category "${d.category}"`);
const all = await allCalcs();
const { Content, headings } = await render(calc);

const related = d.related.map((r) => {
  const hit = findCalc(all, r);
  if (!hit) throw new Error(`${calc.id}: related calculator "${r}" not found`);
  return hit;
});
// top up hand-picked related links with the most similar calculators (any category)
for (const c of similarTo(calc, all, 8, (x) => !related.includes(x))) { if (related.length >= 6) break; related.push(c); }
const more = similarTo(calc, all, 8, (x) => x.data.category === d.category && !related.includes(x));
const popular = POPULAR.map((id) => findCalc(all, id)).filter((c): c is Calc => !!c && c.id !== calc.id).slice(0, 8);
const url = urlOf(calc);
const spec = { title: d.title, variables: d.variables, equations: d.equations, freedom: d.freedom, chart: d.chart, dataset: d.dataset };
const embedCode = embedSnippet(SITE.url, SITE.name, d.title, url);
const escH = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const embedHtml = embedCode.replace(/(<\/?[a-z]+|\/?>)|([a-z-]+)=("[^"]*")|([^<>]+?(?=<|>|[a-z-]+="|$))|([\s\S])/gs, (m, tag, attr, val) =>
  tag ? `<span class="hl-t">${escH(tag)}</span>` : attr ? `<span class="hl-a">${attr}</span>=<span class="hl-s">${escH(val)}</span>` : escH(m));
const shortTitle = (t: string) => t.replace(/\s*\([^)]*\)/g, '').replace(/\s+[–—]\s+.*$/, '');
const author = authorById(d.author);
if (!author) throw new Error(`${calc.id}: unknown author "${d.author}"`);
const reviewer = authorById(d.reviewer);
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const introHtml = d.intro ? esc(d.intro)
  .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
  .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_m, t, u) => /^https?:/.test(u)
    ? `<a href="${u}" target="_blank" rel="noopener">${t}</a>` : `<a href="${u}">${t}</a>`) : '';
const updated = d.updated.toLocaleDateString(SITE.locale, { day: 'numeric', month: 'long', year: 'numeric' });

const schema: object[] = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: cat.name, item: `${SITE.url}/${cat.slug}/` },
    { '@type': 'ListItem', position: 3, name: d.title, item: `${SITE.url}${url}` } ] },
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: d.title, url: `${SITE.url}${url}`, image: `${SITE.url}/og/${d.category}/${slugOf(calc)}.jpg`,
    applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', description: d.description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, dateModified: d.updated.toISOString().slice(0, 10),
    author: { '@type': 'Person', name: author.name, url: `${SITE.url}${authorUrl(author)}`, sameAs: [author.linkedin].filter(Boolean) } },
];
if (d.faq.length) schema.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => (
  { '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
---
<Base title={d.title} description={d.description} schema={schema} activeCat={cat.slug} image={`/og/${d.category}/${slugOf(calc)}.jpg`}>
  <div class="wrap" style={`--accent:${cat.color}`}>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><a href={`/${cat.slug}/`}>{cat.name}</a><span>/</span><span>{d.title}</span>
    </nav>
    <div class="page">
      <article>
        <h1>{d.title}</h1>
        <div class="byline">
          <img src={author.photo} alt="" width="36" height="36" class="byline__img" />
          <span>By <a href={authorUrl(author)} rel="author">{author.name}</a>
            {author.linkedin && <a href={author.linkedin} class="byline__in" target="_blank" rel="noopener" aria-label={`${author.name} on LinkedIn`}>in</a>}
            {reviewer && <> · Reviewed by <a href={authorUrl(reviewer)}>{reviewer.name}</a></>}
            <br /><span class="muted">Updated {updated}</span></span>
        </div>

        <img class="hero-img" src={`/og/${d.category}/${slugOf(calc)}.jpg`} alt={`${d.title}: formula and free online calculator`} width="1200" height="630" fetchpriority="high" decoding="async" />
        {introHtml && <p class="intro" set:html={introHtml} />}

        <section class="panel" aria-label="Calculator">
          <Calculator client:load spec={spec} path={url} />
        </section>

        <div class="prose">
          <Content />

          {d.faq.length > 0 && (
            <section class="faq">
              <h2 id="faq">Frequently asked questions</h2>
              {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
            </section>
          )}

          <h2 id="related">Related calculators</h2>
          <ul class="rel-cards">
            {related.map((c) => { const k = catBySlug(c.data.category)!; return (
              <li style={`--c:${k.color}`}><a href={urlOf(c)}>
                <span class="rel-cards__cat"><span class="rel-cards__ic" aria-hidden="true">{k.icon}</span>{k.name}</span>
                <b>{shortTitle(c.data.title)}</b>
                <span class="rel-cards__d">{c.data.description.replace(/\s+[–—]\s+/g, ', ')}</span>
                <span class="rel-cards__go">Open calculator <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
              </a></li>); })}
          </ul>

          <section class="embed-cta" aria-labelledby="embed">
            <div class="embed-cta__top">
              <div>
                <span class="embed-cta__kick">Free widget</span>
                <h2 id="embed">Put this calculator on your website</h2>
                <p>Copy one snippet. It resizes itself and works on any site or blog.</p>
              </div>
              <button type="button" class="embed-cta__btn" data-copy-embed>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy embed code</span>
              </button>
            </div>
            <pre class="embed-cta__code"><code set:html={embedHtml} /></pre>
            <textarea class="embed-cta__raw" hidden readonly>{embedCode}</textarea>
          </section>
          <script>
            document.querySelectorAll<HTMLButtonElement>('[data-copy-embed]').forEach((b) => b.addEventListener('click', async () => {
              const box = b.closest('.embed-cta')!; const raw = box.querySelector<HTMLTextAreaElement>('.embed-cta__raw')!.value;
              try { await navigator.clipboard.writeText(raw); } catch { const t = document.createElement('textarea'); t.value = raw; document.body.append(t); t.select(); document.execCommand('copy'); t.remove(); }
              const l = b.querySelector('span')!; l.textContent = 'Copied!'; b.classList.add('is-done');
              setTimeout(() => { l.textContent = 'Copy embed code'; b.classList.remove('is-done'); }, 2000);
            }));
          </script>
        </div>
      </article>

      <aside class="side">
        {headings.length > 0 && (
          <nav class="panel toc" aria-label="On this page">
            <h2>On this page</h2>
            <ul>{headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
              {d.faq.length > 0 && <li><a href="#faq">FAQ</a></li>}</ul>
          </nav>
        )}
        <div class="panel"><h2>Popular calculators</h2>
          <ul>{popular.map((c) => <li><a href={urlOf(c)}>{c.data.title}</a></li>)}</ul></div>
        {more.length > 0 && (
          <div class="panel"><h2>More in {cat.name}</h2>
            <ul>{more.map((c) => <li><a href={urlOf(c)}>{c.data.title}</a></li>)}</ul></div>
        )}
        <div class="ad-slot">Ad slot (300×250)</div>
      </aside>
    </div>
  </div>
</Base>
