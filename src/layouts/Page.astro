---
// Layout for plain content pages (About, Privacy Policy, Terms…). Used via `layout:` in .md files.
import Base from './Base.astro';
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="wrap" style="max-width:780px;padding:28px 0 40px">
    <h1 style="font-size:clamp(1.8rem,4vw,2.5rem);letter-spacing:-.03em;margin:8px 0 6px">{frontmatter.title}</h1>
    {frontmatter.updated && <p class="muted" style="margin:0 0 8px">Last updated: {frontmatter.updated}</p>}
    <div class="prose"><slot /></div>
  </div>
</Base>
