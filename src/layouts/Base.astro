---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { SITE } from '../site.config.ts';
import { CATEGORIES, NAV_GROUPS, catBySlug } from '../data/categories.ts';
import Logo from '../components/Logo.astro';
import { siFacebook, siInstagram, siYoutube } from 'simple-icons';
const LI = 'M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z';
const ICONS: Record<string, string> = { LinkedIn: LI, Facebook: siFacebook.path, Instagram: siInstagram.path, YouTube: siYoutube.path };
import { allCalcs, findCalc, urlOf } from '../lib/calcs.ts';
const total = (await allCalcs()).length;
const _all = await allCalcs();
const catCount = (slug: string) => _all.filter((c) => c.data.category === slug).length;

interface Props { title: string; description: string; schema?: object[]; activeCat?: string; noindex?: boolean; }
const { title, description, schema = [], activeCat, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/', SITE.url).href;
const fullTitle = title === SITE.name ? title : (title.length + SITE.name.length + 3 <= 65 ? `${title} | ${SITE.name}` : title);
import { POPULAR } from '../data/popular.ts';
const popAll = await allCalcs();
const popular = POPULAR.map((id) => findCalc(popAll, id)).filter(Boolean);
---
<!doctype html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DFQK6J4M9Y"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-DFQK6J4M9Y');
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:image" content={`${SITE.url}/og-image.png`} />
  <meta name="theme-color" content="#4f5bff" />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="hdr">
    <div class="hdr__top wrap">
      <Logo id="lg-h" />
      <div class="search" role="search">
        <input id="q" type="search" placeholder={`Search ${total} calculators…`} autocomplete="off" aria-label="Search calculators"
          aria-controls="q-results" aria-expanded="false" />
        <kbd class="search__kbd">/</kbd>
        <ul id="q-results" class="search__results" role="listbox" hidden></ul>
      </div>
      <button class="theme" id="theme" type="button" aria-label="Toggle dark mode">◐</button>
    </div>
    <nav class="cats wrap" aria-label="Categories">
      {NAV_GROUPS.map((g, i) => g.cats.length === 1 ? (
        <a href={`/${g.cats[0]}/`} class:list={['cats__a', { 'is-active': activeCat === g.cats[0] }]}>{g.name}</a>
      ) : (
        <div class="navg">
          <button type="button" class:list={['cats__a', 'navg__btn', { 'is-active': g.cats.includes(activeCat ?? '') }]} aria-expanded="false" aria-controls={`navg-${i}`}>{g.name}<span class="navg__car" aria-hidden="true">▾</span></button>
          <div class="navg__menu" id={`navg-${i}`}>
            {g.cats.map((slug) => { const c = catBySlug(slug)!; return (
              <a href={`/${c.slug}/`} class:list={{ 'is-active': activeCat === c.slug }}><span class="navg__ic" aria-hidden="true">{c.icon}</span><span><b>{c.name}</b><small>{catCount(c.slug)} calculators</small></span></a>
            ); })}
          </div>
        </div>
      ))}
    </nav>
  </header>

  <main id="main"><slot /></main>

  <footer class="ftr">
    <div class="wrap ftr__grid">
      <div>
        <Logo id="lg-f" />
        <p class="muted">{SITE.tagline}.</p>
        <div class="ftr__social">
          {SITE.social.map((x) => <a href={x.url} target="_blank" rel="noopener me" aria-label={`Zenta Calculator on ${x.name}`} title={x.name}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS[x.name]} /></svg></a>)}
        </div>
      </div>
      <div class="ftr__cats">
        {CATEGORIES.map((c) => <a href={`/${c.slug}/`}>{c.name}</a>)}
      </div>
      <div class="ftr__cats ftr__pop">
        <b>Popular calculators</b>
        {popular.map((c) => <a href={urlOf(c!)}>{c!.data.title.replace(/ \(.*\)$/, '')}</a>)}
      </div>
    </div>
    <div class="wrap ftr__row">
      <nav class="ftr__links" aria-label="Site">
        <a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy Policy</a><a href="/terms-of-use/">Terms of Use</a><a href="/disclaimer/">Disclaimer</a>
      </nav>
      <a class="ftr__sister" href="https://zentapdf.com/" title="ZentaPDF: free PDF and image tools">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
        <span><b>Free PDF Tools</b><small>Edit, compress and convert PDFs on ZentaPDF</small></span>
      </a>
    </div>
    <p class="wrap muted ftr__copy">© {new Date().getFullYear()} {SITE.name}. Results are for information only.</p>
  </footer>

  <script>
    // category dropdowns: hover on desktop (CSS), click/tap toggles everywhere
    const groups = [...document.querySelectorAll<HTMLElement>('.navg')];
    const closeAll = (except?: HTMLElement) => groups.forEach((g) => { if (g !== except) { g.classList.remove('open'); g.querySelector('button')!.setAttribute('aria-expanded', 'false'); } });
    groups.forEach((g) => {
      const b = g.querySelector('button')!;
      b.addEventListener('click', (ev) => { ev.stopPropagation(); const o = !g.classList.contains('open'); closeAll(g); g.classList.toggle('open', o); b.setAttribute('aria-expanded', String(o)); });
    });
    document.addEventListener('click', () => closeAll());
    document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') closeAll(); });
  </script>
  <script>
    // Theme toggle
    const root = document.documentElement;
    document.getElementById('theme')?.addEventListener('click', () => {
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch {}
    });

    // Instant search over /search.json (title + keywords + category) — header box and any [data-search] box
    type Item = { t: string; u: string; c: string; k: string };
    let items: Item[] | null = null;
    const load = async () => { if (!items) items = await (await fetch('/search.json')).json(); };
    const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]!));
    const bind = (q: HTMLInputElement, list: HTMLUListElement) => {
      let sel = -1, hits: Item[] = [];
      const render = () => {
        list.innerHTML = hits.map((h, i) =>
          `<li role="option" aria-selected="${i === sel}"><a href="${h.u}"><span>${esc(h.t)}</span><small>${esc(h.c)}</small></a></li>`).join('')
          || (q.value.trim() ? '<li class="search__none">No calculator found</li>' : '');
        list.hidden = !list.innerHTML; q.setAttribute('aria-expanded', String(!list.hidden));
      };
      q.addEventListener('focus', load);
      q.addEventListener('input', async () => {
        await load();
        const words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
        hits = words.length ? items!.map((it) => {
          const t = it.t.toLowerCase(), hay = `${t} ${it.k} ${it.c.toLowerCase()}`;
          if (!words.every((w) => hay.includes(w))) return null;
          const score = words.reduce((s, w) => s + (t.startsWith(w) ? 3 : t.includes(w) ? 2 : 1), 0);
          return { it, score };
        }).filter(Boolean).sort((a, b) => b!.score - a!.score).slice(0, 8).map((x) => x!.it) : [];
        sel = -1; render();
      });
      q.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { sel = Math.min(sel + 1, hits.length - 1); render(); e.preventDefault(); }
        else if (e.key === 'ArrowUp') { sel = Math.max(sel - 1, 0); render(); e.preventDefault(); }
        else if (e.key === 'Enter' && hits[Math.max(sel, 0)]) location.href = hits[Math.max(sel, 0)].u;
        else if (e.key === 'Escape') { list.hidden = true; q.blur(); }
      });
      document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.search')) list.hidden = true; });
    };
    const q = document.getElementById('q') as HTMLInputElement;
    bind(q, document.getElementById('q-results') as HTMLUListElement);
    document.querySelectorAll<HTMLElement>('[data-search]').forEach((box) =>
      bind(box.querySelector('input')!, box.querySelector('ul')!));
    // ?q= deep link (Google sitelinks search box)
    const pq = new URLSearchParams(location.search).get('q');
    const main = document.querySelector<HTMLInputElement>('[data-search] input') ?? q;
    if (pq) { main.value = pq; main.dispatchEvent(new Event('input')); main.focus(); }
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && !(e.target as Element).closest('input,textarea,select')) { e.preventDefault(); main.focus(); }
    });
  </script>
</body>
</html>
